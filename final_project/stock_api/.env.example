# Copy to .env_local (manual/local run) or .env_docker (docker-compose)
# and fill in real values. Both files are gitignored.

# stock_service.settings.development or stock_service.settings.production
DJANGO_SETTINGS_MODULE=stock_service.settings.development

DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=stock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change-me

REDIS_HOST=localhost

# Required by stock_service.settings.production (no insecure fallback there)
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Shared secret store_api sends as `Authorization: Service <token>`.
# Must be the same value in store_api's own .env file.
STOCK_API_TOKEN=change-me

# Hours a PENDING reservation is kept before the periodic Celery task
# cancels it automatically.
RESERVATION_EXPIRY_HOURS=24

SENTRY_DSN=
