# Copy to .env_local (manual/local run) or .env_docker (docker-compose)
# and fill in real values. Both files are gitignored.

# book_store.settings.development or book_store.settings.production
DJANGO_SETTINGS_MODULE=book_store.settings.development

DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=book_store_db
POSTGRES_USER=book_store_user
POSTGRES_PASSWORD=change-me

REDIS_HOST=localhost

# Required by book_store.settings.production (no insecure fallback there)
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True only once the app is served behind TLS (directly or via a
# reverse proxy that sets X-Forwarded-Proto)
USE_HTTPS=False

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

SENTRY_DSN=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
